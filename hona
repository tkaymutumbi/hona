def md_to_html(text, title):
    try:
        import markdown  # optional
        body = markdown.markdown(text, extensions=["fenced_code", "tables"])
    except Exception:
        body = "<pre>" + html.escape(text) + "</pre>"
    return PAGE_SHELL.replace("{{title}}", html.escape(title)).replace("{{body}}", body)

def decorate(t, base=None):
    """Add favicon (unless the page has one) and the hona runtime, ahead of the page's own scripts."""
    pre = (f'<base href="{base}">' if base else "") + (RUNTIME if re.search(r"""rel=["']?icon""", t) else ICON + RUNTIME)
    if re.search(r"<head", t, re.I): return re.sub(r"<head[^>]*>", lambda m: m.group(0) + pre, t, 1, flags=re.I)
    if re.match(r"\s*<!doctype", t, re.I): return re.sub(r"^(\s*<!doctype[^>]*>)", lambda m: m.group(1) + pre, t, 1, flags=re.I)
    return pre + t

# ── server ──────────────────────────────────────────────────────────────────
seen = {}  # slug -> last poll timestamp

class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def send(self, code, body, ctype="text/html; charset=utf-8", headers=()):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code); self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b))); self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        for k, v in headers: self.send_header(k, v)
        self.end_headers(); self.wfile.write(b)
    def js(self, obj, code=200): self.send(code, json.dumps(obj), "application/json")
    def body_json(self):
        try: return json.loads(self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 1_000_000)) or b"{}")
        except Exception: return {}

    def guard(self, write):
        """Stop other websites (CSRF / DNS rebinding) and, on LAN, anyone without the token."""
        cfg = config(); host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        if self.client_address[0] in LOOPBACK:
            if host not in ("localhost", "127.0.0.1", "::1"): self.send(421, "bad host"); return False
        else:
            q = parse_qs(urlparse(self.path).query).get("t", [""])[0]
            ck = (self.headers.get("Cookie") or "")
            tok = cfg.get("token", "")
            if not (cfg.get("lan") and tok and (secrets.compare_digest(q, tok) or f"hona_t={tok}" in ck.replace(" ", ""))):
                self.send(401, "hona: token required"); return False
        if write:
            o = self.headers.get("Origin")
            if o and urlparse(o).netloc != self.headers.get("Host"): self.send(403, "cross-origin"); return False
        return True

    def route(self, method):
        if not self.guard(method != "GET"): return
        u = urlparse(self.path); p = u.path.strip("/").split("/")
        cookie = []
        tq = parse_qs(u.query).get("t", [""])[0]
        if tq and self.client_address[0] not in LOOPBACK:  # first LAN visit: swap ?t= for a cookie
            return self.send(302, "", headers=[("Location", u.path), ("Set-Cookie", f"hona_t={tq}; Path=/; HttpOnly; SameSite=Strict")])

        if method == "GET":
            if p == [""]:
                ms = all_meta()
                def badge(m):
                    d = current_decision(m["slug"]); n = cur_version(m["slug"])
                    if not d: return ""
                    stale = d["version"] != n; cls = "ok" if d["decision"] == "approve" else "warn"
                    word = "approved" if d["decision"] == "approve" else "changes"; dv = d["version"]
                    return f'<span class="h-badge {cls}" style="{"opacity:.55" if stale else ""}">{word}{f" v{dv}" if stale else ""}</span>'
                items = "".join(f'<div class="h-card pg{" pinned" if m.get("pinned") else ""}" data-slug="{m["slug"]}"><a class="pg-main" href="/a/{m["slug"]}"><strong>{html.escape(m["title"])}</strong>{f'<div class="pg-desc">{html.escape(m.get("description", ""))}</div>' if m.get("description") else ""}<div class="h-eyebrow">{m["slug"]} · v{cur_version(m["slug"])} · {time.strftime("%b %d %H:%M", time.localtime(m["updated"]))}</div></a><div class="pg-side">{badge(m)}<button class="pgb" data-act="{"unpin" if m.get("pinned") else "pin"}">{"unpin" if m.get("pinned") else "pin"}</button><button class="pgb rm" data-act="remove">remove</button></div></div>' for m in ms)
                tr = trash_items()
                trash_html = ('<details class="trash"><summary>trash (%d)</summary>' % len(tr) + "".join(f'<div class="tr"><span>{html.escape(t["title"])} <span class="h-eyebrow">{t["slug"]}</span></span><span class="pg-side"><button class="pgb" data-act="restore" data-name="{t["name"]}">restore</button><button class="pgb rm" data-act="purge" data-name="{t["name"]}">delete forever</button></span></div>' for t in tr) + "</details>") if tr else ""
                return self.send(200, INDEX.replace("{{count}}", str(len(ms))).replace("{{trash}}", trash_html).replace("{{items}}", items or '<div class="h-card">nothing published yet — run <code>hona publish page.html</code></div>'))
            if p[0] == "_" and len(p) == 2 and p[1] in ("favicon.svg", "hona.css", "hona.js") and (ASSETS / p[1]).is_file():
                ct = {"svg": "image/svg+xml", "css": "text/css; charset=utf-8", "js": "text/javascript; charset=utf-8"}[p[1].rsplit(".", 1)[1]]
                return self.send(200, (ASSETS / p[1]).read_bytes(), ct)
            if p == ["favicon.ico"]: return self.send(200, (ASSETS / "favicon.svg").read_bytes(), "image/svg+xml")
            if p[0] == "a" and len(p) == 4 and p[2] == "v" and p[3].isdigit() and meta(p[1]):
                vh = version_html(p[1], p[3])
                return self.send(200, decorate(vh, base=f"/a/{p[1]}/")) if vh is not None else self.send(404, "no such version")
            if p[0] == "a" and len(p) >= 2 and meta(p[1]):
                f = ((STORE / p[1] / "/".join(p[2:])) if len(p) > 2 else STORE / p[1] / "index.html").resolve()
                if STORE.resolve() in f.parents and f.is_file() and f.name not in ("comments.json", "meta.json") and "data" not in f.relative_to(STORE / p[1]).parts[:1]:
                    if f.name == "index.html" and len(p) == 2: return self.send(200, decorate(f.read_text()))
                    return self.send(200, f.read_bytes(), mimetypes.guess_type(f.name)[0] or "application/octet-stream")
            if p[0] == "a" and len(p) == 2 and not meta(p[1]): return self.send(404, "not found")
        if p[0] == "api" and p[1] == "pages" and len(p) == 4 and method == "POST":
            name, act = p[2], p[3]
            if act in ("pin", "unpin") and meta(name): pin_page(name, act == "pin"); return self.js({"ok": True})
            if act == "remove" and meta(name): return self.js({"name": remove_page(name)})
            if act == "restore" and ID2_RE.match(name):
                s = restore_page(name); return self.js({"slug": s}) if s else self.js({"error": "not in trash"}, 404)
            if act == "purge" and ID2_RE.match(name): return self.js({"ok": purge_page(name)})
            return self.send(404, "not found")
        if p[0] == "api" and len(p) >= 3 and meta(p[2]):
            return self.api(method, p[1], p[2], p[3:])
        self.send(404, "not found")

    def api(self, method, kind, slug, rest):
        if kind == "poll" and method == "GET":
            seen[slug] = time.time(); cs = get_comments(slug)
            return self.js({"v": meta(slug)["updated"], "c": len(cs) * 1000 + sum(x["resolved"] + (x.get("pinned") is False) for x in cs), "d": len(get_decisions(slug)), "h": len(get_choices(slug)), "a": len(get_asks(slug)) * 1000 + sum(x["status"] == "answered" for x in get_asks(slug))})
        if kind == "seen" and method == "GET": return self.js({"open": time.time() - seen.get(slug, 0) < WATCH_TTL})
        if kind == "decision":
            cur, n = current_decision(slug), cur_version(slug)
            if method == "GET": return self.js({"current": cur, "version": n, "stale": bool(cur and cur["version"] != n)})
            if method == "POST":
                b = self.body_json(); dec = b.get("decision"); note = str(b.get("note") or "").strip()
                if dec not in ("approve", "changes") or (dec == "changes" and not note): return self.js({"error": "bad decision"}, 400)
                d = add_decision(slug, dec, note); notify(f"hona · {meta(slug)['title']}", decision_label(d) + (": " + note if note else "")); return self.js(d)
        if kind == "versions" and method == "GET":
            ds = get_decisions(slug)
            return self.js([{**v, "decision": next(({"decision": d["decision"], "note": d["note"]} for d in reversed(ds) if d["version"] == v["n"]), None)} for v in reversed(get_versions(slug))])
        if kind == "restore" and method == "POST" and len(rest) == 1 and rest[0].isdigit():
            vh = version_html(slug, rest[0])
            if vh is None: return self.js({"error": "no such version"}, 404)
            m = meta(slug); n, _ = commit_version(slug, vh, m["title"]); write_json(STORE / slug / "meta.json", {**m, "updated": time.time(), "version": n}); return self.js({"version": n})
        if kind == "diff" and method == "GET" and len(rest) == 2 and rest[0].isdigit() and rest[1].isdigit():
            ln = text_diff(slug, rest[0], rest[1]); return self.js({"lines": ln}) if ln is not None else self.js({"error": "no such version"}, 404)
        if kind == "asks":
            if method == "GET" and not rest: return self.js(get_asks(slug))
            if method == "GET" and len(rest) == 1 and rest[0].isdigit():
                x = next((x for x in get_asks(slug) if x["id"] == int(rest[0])), None); return self.js(x) if x else self.js({"error": "not found"}, 404)
            if method == "POST" and not rest:
                p = str(self.body_json().get("prompt", "")).strip()
                if not p: return self.js({"error": "empty prompt"}, 400)
                a = add_ask(slug, p)
                if not a: return self.js({"error": "too many unanswered questions; wait for the agent"}, 429)
                notify(f"hona · {meta(slug)['title']} asks", p); return self.js(a)
        if kind == "choices":
            if method == "GET": return self.js({g: {"value": e["value"], "version": e["version"]} for g, e in current_choices(slug).items()})
            if method == "POST":
                b = self.body_json(); g, v = str(b.get("group", "")), str(b.get("value", ""))
                if not CH_RE.match(g) or (v and not CH_RE.match(v)): return self.js({"error": "bad choice"}, 400)
                e = add_choice(slug, g, v); notify(f"hona · {meta(slug)['title']}", f"{g} = {v or 'cleared'}"); return self.js(e)
        if kind == "comments":
            if method == "GET" and not rest: return self.js(get_comments(slug))
            if method == "POST" and not rest:
                b = self.body_json(); text = str(b.get("text", "")).strip()
                if not text: return self.js({"error": "empty"}, 400)
                par = b.get("parent"); an = b.get("anchor")
                if not (isinstance(an, dict) and an.get("type") in ("text", "pin", "draw") and len(json.dumps(an)) < 150_000): an = None
                cm = add_comment(slug, "you", text, str(b.get("quote") or ""), par if isinstance(par, int) else None, an)
                notify(f"hona · {meta(slug)['title']}", text); return self.js(cm)
            if method == "POST" and len(rest) == 2 and rest[0].isdigit() and rest[1] in ("resolve", "reopen"):
                set_resolved(slug, int(rest[0]), rest[1] == "resolve"); return self.js({"ok": True})
            if method == "POST" and len(rest) == 2 and rest[0].isdigit() and rest[1] in ("delete", "undelete"):
                set_deleted(slug, int(rest[0]), rest[1] == "delete"); return self.js({"ok": True})
            if method == "POST" and len(rest) == 2 and rest[0].isdigit() and rest[1] in ("pin", "unpin"):
                set_pinned(slug, int(rest[0]), rest[1] == "pin"); return self.js({"ok": True})
        if kind == "db" and rest and ID_RE.match(rest[0]):
            coll = rest[0]
            if method == "GET" and len(rest) == 1: return self.js([{"id": k, **v} if isinstance(v, dict) else {"id": k, "value": v} for k, v in db_read(slug, coll).items()])
            if len(rest) == 2 and ID_RE.match(rest[1]):
                did = rest[1]
                if method == "GET":
                    d = db_read(slug, coll); return self.js(d[did]) if did in d else self.js({"error": "not found"}, 404)
                if method == "PUT": doc = self.body_json(); db_write(slug, coll, lambda d: d.__setitem__(did, doc)); return self.js({"ok": True})
                if method == "DELETE": db_write(slug, coll, lambda d: d.pop(did, None)); return self.js({"ok": True})
        self.send(404, "not found")

    def do_GET(self): self.route("GET")
    def do_POST(self): self.route("POST")
    def do_PUT(self): self.route("PUT")
    def do_DELETE(self): self.route("DELETE")

def server_up():
    try: urllib.request.urlopen(f"{BASE}/_/favicon.svg", timeout=0.5); return True
    except Exception: return False

def ensure_server():
    if server_up(): return False
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(30):
        time.sleep(0.1)
        if server_up(): return True
    fail("server did not start", f"Run `hona serve` in a terminal to see the error (port {PORT} busy? set HONA_PORT).")

def stop_server():
    try: os.kill(int(PIDFILE.read_text()), signal.SIGTERM)
    except Exception: pass
    for _ in range(30):
        if not server_up(): return
        time.sleep(0.1)

def open_browser(url):
    for cmd in (["omarchy-launch-browser", url], ["xdg-open", url]):
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True); return True
    return False

def lan_url(slug=""):
    cfg = config(); ip = lan_ip()
    return f"http://{ip}:{PORT}/{'a/' + slug if slug else ''}?t={cfg['token']}" if cfg.get("lan") and ip else None


def chrome_bin():
    return next((p for p in (shutil.which(c) for c in ("chromium", "chromium-browser", "google-chrome-stable", "google-chrome")) if p), None)

def snap(slug, cid=None, out=None, theme=None):
    """Render the page with annotations drawn on it (headless Chromium). Returns the png path or None."""
    chrome = chrome_bin()
    if not chrome: return None
    ensure_server()
    an = next((x.get("anchor") for x in get_comments(slug) if x["id"] == cid), None) if cid else None
    w = int((an or {}).get("vw") or 1280); h = min(int((an or {}).get("docH") or 1600) + 40, 8000)
    theme = theme or (an or {}).get("theme") or config().get("snap_theme")  # light | dark | None = system
    flags = {"light": ["--blink-settings=preferredColorScheme=1"], "dark": ["--blink-settings=preferredColorScheme=0"]}.get(theme, [])
    out = Path(out) if out else HOME / "snaps" / f"{slug}-{cid or 'all'}.png"
    out.parent.mkdir(parents=True, exist_ok=True); out.unlink(missing_ok=True)
    try:
        subprocess.run([chrome, "--headless=new", "--no-sandbox", "--disable-gpu", "--hide-scrollbars", *flags, f"--window-size={w},{h}",
                        "--virtual-time-budget=4000", f"--screenshot={out}", f"{BASE}/a/{slug}?hona_snap={cid or 'all'}"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=40)
    except Exception: return None
    return out if out.exists() else None

def run_check(slug):
    """Render the page at desktop and phone width in light and dark, and report what a reviewer would trip over.
    Returns {"ok": bool, "issues": [str], "notes": [str], "renders": n} or None if Chromium is missing."""
    chrome = chrome_bin()
    if not chrome: return None
    ensure_server()
    combos = [("desktop", 1280, 800, "light"), ("desktop", 1280, 800, "dark"), ("phone", 390, 800, "light"), ("phone", 390, 800, "dark")]
    def one(c):
        name, w, hh, theme = c
        try:
            out = subprocess.run([chrome, "--headless=new", "--no-sandbox", "--disable-gpu", "--hide-scrollbars", f"--window-size={w},{hh}",
                                  f"--blink-settings=preferredColorScheme={0 if theme == 'dark' else 1}", "--virtual-time-budget=5000", "--dump-dom",
                                  f"{BASE}/a/{slug}?hona_check=1"], capture_output=True, text=True, timeout=45).stdout
            m = re.search(r'<pre id="hona-check">(.*?)</pre>', out, re.S)
            return c, (json.loads(html.unescape(m.group(1))) if m else None)
        except Exception: return c, None
    with concurrent.futures.ThreadPoolExecutor(4) as ex: results = list(ex.map(one, combos))
    found, ok = {}, 0                      # message -> [where, ...]
    def add(msg, where):  # noqa: F811
        w = found.setdefault(msg, [])
        if where and where not in w: w.append(where)
    for (name, w, _, theme), r in results:
        if not r: continue
        ok += 1; where = f"{name} {theme}"
        for e in r["errors"]: add(f"console error: {e}", where)
        for f in r["failed"]: add(f"failed to load: {f} (pages should be self-contained)", where)
        if r.get("overflowBy"):
            add(f"sideways scroll: page is wider than the screen" + (f"; widest: {'; '.join(r['overflow'])}" if r["overflow"] else ""), f"{name} {w}px")
        for c in r["contrast"]: add(f"low contrast: {c}", where)
        if r["tiny"]: add(f"tiny text: {r['tiny']} element(s) under 11px", where)
        if name == "desktop" and theme == "light":
            if not r["title"]: add("no <title>: the page needs a short name", None)
            if not r["viewport"]: add('no viewport meta: add <meta name="viewport" content="width=device-width,initial-scale=1">', None)
            if not r["bodyBg"]: add("no explicit page background: set one from a colour token so the page looks right in both themes", None)
    issues = [m + (f"  [{'everywhere' if len(w) >= ok > 1 else ', '.join(w)}]" if w else "") for m, w in found.items()]
    return {"ok": not issues and ok > 0, "issues": issues, "notes": [], "renders": ok}

def check_lines(r):
    if r is None: return ["check skipped: Chromium not found"]
    if not r["renders"]: return ["check could not render the page"]
    return [f"check passed ({r['renders']} renders: desktop and phone, light and dark)"] if r["ok"] else [f"check found {len(r['issues'])} issue(s) (desktop and phone, light and dark):"] + [f"  - {i}" for i in r["issues"]]

def anchor_line(x):
    a = x.get("anchor") or {}
    if a and x.get("pinned") is False: return "(unpinned by the user: marks hidden on the page)"
    if a.get("type") == "pin": return f'pin on {a.get("label", "?")}  [{a.get("selector", "")}] at ({int(a.get("x", 0))},{int(a.get("y", 0))})'
    if a.get("type") == "draw":
        kinds = ", ".join(sorted({s.get("tool", "?") for s in a.get("strokes", [])}))
        pts = [p for s in a.get("strokes", []) for p in s.get("pts", [])]
        box = f' within x {int(min(p[0] for p in pts))}–{int(max(p[0] for p in pts))}, y {int(min(p[1] for p in pts))}–{int(max(p[1] for p in pts))}' if pts else ""
        return f'drawing: {len(a.get("strokes", []))} mark(s) ({kinds}){box}'
    return ""

def needs_shot(x): return (x.get("anchor") or {}).get("type") in ("pin", "draw") and x.get("pinned") is not False

# ── core operations (shared by the CLI and the MCP server; they never print) ──
def need_slug(a):
    s = slugify(a) if a else (all_meta() or [{}])[0].get("slug")
    if not s or not meta(s): fail("no such artifact", "Run `hona list` to see slugs.")
    return s

def focus_window(titles):
    """Bring the browser window showing this page to the front (Hyprland). Runs detached; returns False if unsupported."""
    if not (shutil.which("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")): return False
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "_focus", *[t for t in titles if t]],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return True

def do_publish(raw, name="page", src=None, title=None, slug=None, no_open=False, no_focus=False, force_md=None, description=None, check=None):
    if not title:
        m = re.search(r"<title>(.*?)</title>", raw, re.S | re.I) or re.search(r"^#\s+(.+)$", raw, re.M)
        title = html.unescape(m.group(1).strip()) if m else name
    slug = slugify(slug or title)
    is_md = force_md if force_md is not None else (bool(src) and Path(src).suffix.lower() in (".md", ".markdown"))
    page = md_to_html(raw, title) if is_md else raw
    d = STORE / slug; existed = d.exists(); d.mkdir(parents=True, exist_ok=True)
    if src and Path(src).parent.resolve() != d and not is_md:  # copy sibling assets for multi-file pages
        for f in Path(src).parent.iterdir():
            if f.is_file() and f.suffix.lower() in (".css", ".js", ".png", ".jpg", ".svg", ".webp", ".json") and f.name not in ("meta.json", "comments.json", "versions.json", "decisions.json"):
                shutil.copy(f, d / f.name)
    n, changed = commit_version(slug, page, title)
    old = meta(slug) or {}
    write_json(d / "meta.json", {"slug": slug, "title": title, "created": old.get("created", time.time()),
                                 "updated": time.time() if (changed or not old) else old["updated"], "version": n, "pinned": bool(old.get("pinned")),
                                 "description": (description if description is not None else old.get("description") or (re.search(r"""<meta[^>]*name=["']description["'][^>]*content=["']([^"']*)""", page, re.I) or [None, ""])[1])[:300]})
    started = ensure_server(); url = f"{BASE}/a/{slug}"
    try: already = json.load(urllib.request.urlopen(f"{BASE}/api/seen/{slug}", timeout=1))["open"]
    except Exception: already = False
    opened = focused = False
    if not no_open and not already:
        opened = open_browser(url)
        if opened and config().get("focus", True) and not no_focus:
            tm = re.search(r"<title>(.*?)</title>", page, re.S | re.I)
            focused = focus_window([html.unescape(tm.group(1).strip()) if tm else "", title])
    dec = current_decision(slug)
    chk = run_check(slug) if (config().get("check", True) if check is None else check) else False
    return {"check": chk, "slug": slug, "title": title, "url": url, "version": n, "changed": changed, "existed": existed, "bytes": len(raw), "markdown": is_md,
            "server_started": started, "opened": opened, "reloaded": already, "focused": focused, "decision": dec,
            "decision_stale": bool(dec and dec["version"] != n), "open_comments": len([x for x in get_comments(slug) if not x["parent"] and not x["resolved"]])}

def feedback(slug, wait=False, timeout=600, all_=False, shots=True):
    """New user comments and decisions since the agent last looked. wait=True blocks until something arrives."""
    cur = STORE / slug / "agent_cursor.json"
    def pending():
        st = read_json(cur, {})
        return ([x for x in get_comments(slug) if x["author"] == "you" and x["id"] > st.get("seen", 0)],
                [d for d in get_decisions(slug) if d["id"] > st.get("dseen", 0)],
                [e for e in get_choices(slug) if e["id"] > st.get("hseen", 0)],
                [x for x in get_asks(slug) if x["id"] > st.get("aseen", 0)])
    start = time.time(); items, decs, chs, asks = pending()
    if wait:
        while not items and not decs and not chs and not asks and time.time() - start < timeout: time.sleep(1); items, decs, chs, asks = pending()
    cs = get_comments(slug)
    root = lambda x: next((r for r in cs if r["id"] == x["parent"]), x) if x["parent"] else x
    show = [x for x in cs if not root(x)["resolved"] or x in items] if all_ else items
    st = read_json(cur, {})
    if items: st["seen"] = max(x["id"] for x in items)
    if decs: st["dseen"] = max(d["id"] for d in decs)
    if chs: st["hseen"] = max(e["id"] for e in chs)
    if asks: st["aseen"] = max(x["id"] for x in asks)
    if items or decs or chs or asks: write_json(cur, st)
    sh = {}
    if shots:
        for x in show:
            if needs_shot(x) and not x["parent"]:
                p = snap(slug, x["id"])
                if p: sh[x["id"]] = str(p)
    return {"show": show, "decisions": decs, "choices": chs, "asks": asks, "current": current_decision(slug), "version": cur_version(slug), "shots": sh}

def item_lines(x, shots):
    q = f' re: "{x["quote"][:80]}"' if x["quote"] else ""
    par = f" (reply to #{x['parent']})" if x["parent"] else ""
    out = [f"#{x['id']} {x['author']}{par}{q}{' [resolved]' if x['resolved'] else ''}", f"  {x['text']}"]
    if anchor_line(x): out.append(f"  {anchor_line(x)}")
    if x["id"] in shots: out.append(f"  screenshot: {shots[x['id']]}")
    return out

def decision_lines(d, version):
    stale = f" (page is now v{version}; this review is out of date)" if d["version"] != version else ""
    return [f"decision: {decision_label(d)} on v{d['version']}{stale}"] + ([f"  note: {d['note']}"] if d["note"] else [])

# ── commands ────────────────────────────────────────────────────────────────
def cmd_publish(args):
    title = slug = desc = None; no_open = no_focus = no_check = False; src = None; i = 0
    while i < len(args):
        a = args[i]
        if a in ("-t", "--title"): title = args[i + 1]; i += 2
        elif a in ("-d", "--description"): desc = args[i + 1]; i += 2
        elif a == "--no-check": no_check = True; i += 1
        elif a in ("-s", "--slug"): slug = args[i + 1]; i += 2
        elif a == "--no-open": no_open = True; i += 1
        elif a == "--no-focus": no_focus = True; i += 1
        else: src = a; i += 1
    banner("publish")
    if src is None: fail("no file given", "Usage: hona publish <file.html|file.md|-> [--title T] [--slug S] [--no-open] [--no-focus] [--no-check] [--description D]")
    if src == "-": raw, name, srcp = sys.stdin.read(), "stdin", None
    else:
        p = Path(src)
        if not p.is_file(): fail(f"file not found: {src}", "Check the path, or pipe content with `hona publish -`.")
        raw, name, srcp = p.read_text(), p.stem, src
    r = do_publish(raw, name, srcp, title, slug, no_open, no_focus, None, desc, False if no_check else None)
    step(1, 3, "read page", note=f"{r['bytes']:,} bytes" + (" · markdown" if r["markdown"] else ""))
    step(2, 3, "stored", note=(f"v{r['version']} · " if r["changed"] else f"unchanged, still v{r['version']} · ") + ("updated in place · comments kept" if r["existed"] else "new"))
    step(3, 3, "serving", note="server started" if r["server_started"] else "server running")
    print(dim("│"))
    row("title", bold(r["title"])); row("link", cyan(r["url"])); row("version", f"v{r['version']}")
    if lan_url(r["slug"]): row("lan", cyan(lan_url(r["slug"])))
    row("browser", (green("opened") + (dim(" · focused") if r["focused"] else "")) if r["opened"] else (yellow("reloaded existing tab") if r["reloaded"] else dim("not opened")))
    d = r["decision"]
    if d: row("review", (yellow if d["decision"] == "changes" else green)(decision_label(d)) + dim(f" on v{d['version']}" + (f" · v{r['version']} not reviewed yet" if r["decision_stale"] else "")))
    if r["check"] is not False:
        cl = check_lines(r["check"])
        row("check", (green if r["check"] and r["check"]["ok"] else yellow)(cl[0]))
        for extra in cl[1:]: print(f"{dim('│')}            {extra}")
    if r["open_comments"]: row("comments", yellow(f"{r['open_comments']} open") + dim(f" · hona comments {r['slug']} --all"))
    sg = r["slug"]
    print(f"{dim('└')} {green('✔')} done · next: {bold(f'hona comments {sg} --wait')}")
    if not TTY: print(r["url"])

def cmd_list(_):
    banner("list"); items = all_meta()
    if not items: print(f"{dim('└')} {yellow('!')} nothing published yet · try {bold('hona publish page.html')}"); return
    w = max(len(m["slug"]) for m in items)
    for m in items:
        n = len([x for x in get_comments(m["slug"]) if not x["parent"] and not x["resolved"]]); d = current_decision(m["slug"]); v = cur_version(m["slug"])
        tags = (f"  {yellow(f'{n} open')}" if n else "") + (f"  {(green if d['decision'] == 'approve' else yellow)(decision_label(d).lower())}" + (dim(f" (v{d['version']})") if d["version"] != v else "") if d else "")
        print(f"{dim('├')} {bold(m['slug'].ljust(w))}  {dim('v' + str(v))}  {dim(time.strftime('%b %d %H:%M', time.localtime(m['updated'])))}  {m['title']}{tags}")
    print(f"{dim('└')} {green('✔')} {len(items)} artifact(s) · index: {cyan(BASE)}")

def cmd_open(args):
    banner("open"); slug = need_slug(args[0] if args else None)
    ensure_server(); open_browser(f"{BASE}/a/{slug}")
    print(f"{dim('└')} {green('✔')} opened {cyan(f'{BASE}/a/{slug}')}")

def cmd_rm(args):
