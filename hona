def mcp_call(name, a):
    """Returns a list of MCP content blocks."""
    import base64
    text = lambda s: [{"type": "text", "text": s}]
    img = lambda p: [{"type": "image", "data": base64.b64encode(Path(p).read_bytes()).decode(), "mimeType": "image/png"}] if p and Path(p).is_file() and Path(p).stat().st_size < 4_500_000 else []
    sl = lambda: need_slug(a.get("slug"))
    if name == "hona_publish":
        if a.get("html") is not None: raw, nm, src = a["html"], "page", None
        elif a.get("file"):
            p = Path(a["file"]).expanduser()
            if not p.is_file(): return text(f"file not found: {p}")
            raw, nm, src = p.read_text(), p.stem, str(p)
        else: return text("give either html or file")
        r = do_publish(raw, nm, src, a["title"], None, a.get("open") is False, False, True if a.get("markdown") else None, a.get("description"), None if a.get("check") is None else bool(a["check"]))
        out = [f"Published \"{r['title']}\" as v{r['version']}{'' if r['changed'] else ' (unchanged)'}: {r['url']}",
               f"browser: {'opened' if r['opened'] else 'reloaded existing tab' if r['reloaded'] else 'not opened'}", f"slug: {r['slug']}"]
        if r["decision"]: out += decision_lines(r["decision"], r["version"])
        if r["check"] is not False: out += check_lines(r["check"])
        out.append("Fix any check issues and republish before telling the user." if r["check"] and not r["check"]["ok"] else "Tell the user the link, then call hona_wait_for_feedback.")
        return text("\n".join(out))
    if name == "hona_wait_for_feedback" or name == "hona_feedback":
        slug = sl(); wait = name == "hona_wait_for_feedback"
        f = feedback(slug, wait=wait, timeout=max(1, min(int(a.get("timeout_seconds") or 120), 570)), all_=bool(a.get("all")))
        lines = [l for d in f["decisions"] for l in decision_lines(d, f["version"])] + [l for e in f["choices"] for l in choice_lines(e, f["version"])] + [l for x in f["asks"] for l in ask_lines(x)] + [l for x in f["show"] for l in item_lines(x, f["shots"])]
        if not lines: return text("no feedback yet" + (" (timed out; call again to keep waiting)" if wait else ""))
        lines.append(f"(page {slug} is at v{f['version']}; reply with hona_reply)")
        return text("\n".join(lines)) + [b for p in f["shots"].values() for b in img(p)]
    if name == "hona_reply":
        add_comment(sl(), "agent", a["text"], parent=int(a["comment_id"])); return text("replied")
    if name == "hona_resolve":
        set_resolved(sl(), int(a["comment_id"]), True); return text("resolved")
    if name == "hona_decision":
        slug = sl(); d = current_decision(slug); return text("\n".join(decision_lines(d, cur_version(slug))) if d else "no decision yet")
    if name == "hona_list":
        rows = []
        for m in all_meta():
            n = len([x for x in get_comments(m["slug"]) if not x["parent"] and not x["resolved"]]); d = current_decision(m["slug"])
            rows.append(f"{m['slug']}  v{cur_version(m['slug'])}  {m['title']}" + (f"  [{n} open]" if n else "") + (f"  [{decision_label(d).lower()} v{d['version']}]" if d else ""))
        return text("\n".join(rows) or "nothing published yet")
    if name == "hona_answer":
        slug = sl(); return text("answered" if answer_ask(slug, int(a["ask_id"]), a["answer"]) else "no such question")
    if name == "hona_check":
        return text("\n".join(check_lines(run_check(sl()))))
    if name == "hona_choices":
        slug = sl(); cc = current_choices(slug); return text("\n".join(f"{g} = {e['value']}  (v{e['version']})" for g, e in cc.items()) or "no picks yet")
    if name == "hona_versions":
        slug = sl(); rows = []
        for v in reversed(get_versions(slug)):
            d = next((x for x in reversed(get_decisions(slug)) if x["version"] == v["n"]), None)
            rows.append(f"v{v['n']}  {time.strftime('%b %d %H:%M', time.localtime(v['ts']))}" + (f"  {decision_label(d).lower()}" if d else "") + ("  (current)" if v["n"] == cur_version(slug) else ""))
        return text("\n".join(rows))
    if name == "hona_snapshot":
        p = snap(sl(), a.get("comment_id"), None, a.get("theme")); return (text(str(p)) + img(p)) if p else text("could not render a screenshot (is Chromium installed?)")
    return text(f"unknown tool {name}")

def cmd_mcp(_):
    """stdio MCP server: newline-delimited JSON-RPC on stdin/stdout."""
    def send(o): sys.stdout.write(json.dumps(o) + "\n"); sys.stdout.flush()
    for line in sys.stdin:
        try: msg = json.loads(line)
        except Exception: continue
        mid, method = msg.get("id"), msg.get("method"); params = msg.get("params") or {}
        if method == "initialize":
            send({"jsonrpc": "2.0", "id": mid, "result": {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                  "serverInfo": {"name": "hona", "version": "0.3.0"}, "instructions": "Publish visual deliverables with hona_publish, then hona_wait_for_feedback; look at any screenshots; hona_reply; republish."}})
        elif method == "tools/list": send({"jsonrpc": "2.0", "id": mid, "result": {"tools": mcp_tools()}})
        elif method == "tools/call":
            try: content, err = mcp_call(params.get("name"), params.get("arguments") or {}), False
            except SystemExit: content, err = [{"type": "text", "text": "hona: no such page. Use hona_list to see slugs."}], True
            except Exception as e: content, err = [{"type": "text", "text": f"hona error: {e}"}], True
            send({"jsonrpc": "2.0", "id": mid, "result": {"content": content, "isError": err}})
        elif method == "ping": send({"jsonrpc": "2.0", "id": mid, "result": {}})
        elif mid is not None: send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"method not found: {method}"}})

def cmd_mcpinstall(args):
    """hona mcp-install [status]: register the MCP server with Claude Code, OpenCode and Codex."""
    status = bool(args and args[0] == "status"); me = os.path.realpath(__file__); py = sys.executable
    banner("mcp " + ("status" if status else "install"))
    # Claude Code
    if shutil.which("claude"):
        have = "hona" in (subprocess.run(["claude", "mcp", "list"], capture_output=True, text=True).stdout or "")
        if status or have: step(1, 3, "Claude Code", ok=have, note="registered" if have else "not registered")
        else:
            r = subprocess.run(["claude", "mcp", "add", "--scope", "user", "hona", "--", py, me, "mcp"], capture_output=True, text=True)
            step(1, 3, "Claude Code", ok=r.returncode == 0, note="registered (user scope)" if r.returncode == 0 else (r.stderr.strip()[:80] or "claude mcp add failed"))
    else: step(1, 3, "Claude Code", ok=False, note="`claude` not found")
    # OpenCode
    oc = Path.home() / ".config/opencode/opencode.json"
    if oc.is_file():
        try: cfg = json.loads(oc.read_text()); have = "hona" in (cfg.get("mcp") or {})
        except Exception: cfg, have = None, False
        if cfg is None: step(2, 3, "OpenCode", ok=False, note=f"{oc.name} is not plain JSON; add it by hand (see README)")
        elif status or have: step(2, 3, "OpenCode", ok=have, note="registered" if have else "not registered")
        else:
            bak = oc.with_name("opencode.json.hona.bak")
            if not bak.exists(): shutil.copy(oc, bak)
            cfg.setdefault("mcp", {})["hona"] = {"type": "local", "command": [py, me, "mcp"], "enabled": True}
            oc.write_text(json.dumps(cfg, indent=2) + "\n"); step(2, 3, "OpenCode", note=f"registered (backup: {bak.name})")
    else: step(2, 3, "OpenCode", ok=False, note="no ~/.config/opencode/opencode.json")
    # Codex
    cx = Path.home() / ".codex/config.toml"
    if cx.parent.is_dir():
        txt = cx.read_text() if cx.is_file() else ""; have = "[mcp_servers.hona]" in txt
        if status or have: step(3, 3, "Codex", ok=have, note="registered" if have else "not registered")
        else:
            cx.write_text(txt + ("\n" if txt and not txt.endswith("\n") else "") + f'\n[mcp_servers.hona]\ncommand = "{py}"\nargs = ["{me}", "mcp"]\n'); step(3, 3, "Codex", note="registered in config.toml")
    else: step(3, 3, "Codex", ok=False, note="no ~/.codex")
    print(f"{dim('│')}\n{dim('└')} {green('✔')} done · restart your agent session to load the hona tools")

def cmd_skill(args):
    """hona skill [install|status]: link the hona skill into Claude Code, OpenCode (via ~/.agents) and Codex."""
    mode = args[0] if args else "status"
    src = ASSETS.parent / "skill" / "hona"
    targets = [("Claude Code", Path.home() / ".claude/skills"), ("OpenCode / agents", Path.home() / ".agents/skills"), ("Codex", Path.home() / ".codex/skills")]
    if mode not in ("install", "status", "uninstall"): fail("usage: hona skill [install|status|uninstall]", "")
    if not (src / "SKILL.md").is_file(): fail("skill source not found", f"Expected {src}/SKILL.md (is hona installed from a git clone?).")
    banner(f"skill {mode}")
    bad = 0
    for i, (name, d) in enumerate(targets, 1):
        link = d / "hona"; ok = link.is_symlink() and link.resolve() == src.resolve()
        if mode == "install":
            if link.exists() or link.is_symlink():
                if ok: step(i, 3, name, note=f"already linked · {link}"); continue
                if link.is_symlink(): link.unlink()
                else: step(i, 3, name, ok=False, note=f"{link} exists and is not a link; left alone"); bad += 1; continue
            d.mkdir(parents=True, exist_ok=True); link.symlink_to(src); step(i, 3, name, note=f"linked · {link}")
        elif mode == "uninstall":
            if ok: link.unlink(); step(i, 3, name, note="removed")
            else: step(i, 3, name, ok=False, note="not installed by hona; left alone")
        else:
            step(i, 3, name, ok=ok, note=str(link) if ok else "not installed")
    print(dim("│"))
    if mode == "install": print(f"{dim('└')} {green('✔') if not bad else yellow('!')} done · restart your agent session to pick it up")
    else: print(f"{dim('└')} {green('✔')} done")

def cmd_serve(_):
    STORE.mkdir(parents=True, exist_ok=True)
    host = "0.0.0.0" if config().get("lan") else "127.0.0.1"
    class Srv(ThreadingHTTPServer):
        daemon_threads = True
        def server_bind(self):  # skip HTTPServer's getfqdn(): a slow reverse-DNS lookup on 0.0.0.0
            socketserver.TCPServer.server_bind(self); self.server_name, self.server_port = host, PORT
    srv = Srv((host, PORT), H)
    PIDFILE.write_text(str(os.getpid()))  # only after a successful bind
    srv.serve_forever()

