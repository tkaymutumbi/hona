# choices: STORE/<slug>/choices.json [{id, group, value, ts, version}]; value "" clears the pick
CH_RE = re.compile(r"^[\w .:/+#-]{1,64}$")
def chfile(slug): return STORE / slug / "choices.json"
def get_choices(slug): return read_json(chfile(slug), [])
def add_choice(slug, group, value):
    with locked(chfile(slug)):
        es = get_choices(slug); e = {"id": max([x["id"] for x in es], default=0) + 1, "group": group, "value": value, "ts": time.time(), "version": cur_version(slug)}
        es.append(e); write_json(chfile(slug), es)
    return e
def current_choices(slug):
    out = {}
    for e in get_choices(slug): out[e["group"]] = e
    return {g: e for g, e in out.items() if e["value"] != ""}
def choice_lines(e, version):
    stale = f" (page is now v{version})" if e["version"] != version else ""
    return [f"choice: {e['group']} = {e['value'] or '(cleared)'} on v{e['version']}{stale}"]

# asks: a page asks the agent a question; STORE/<slug>/asks.json [{id, prompt, ts, version, status, answer, answered}]
def asfile(slug): return STORE / slug / "asks.json"
def get_asks(slug): return read_json(asfile(slug), [])
def add_ask(slug, prompt):
    with locked(asfile(slug)):
        xs = get_asks(slug)
        if sum(1 for x in xs if x["status"] == "pending") >= 20: return None
        a = {"id": max([x["id"] for x in xs], default=0) + 1, "prompt": prompt[:8000], "ts": time.time(), "version": cur_version(slug), "status": "pending", "answer": None, "answered": None}
        xs.append(a); write_json(asfile(slug), xs)
    return a
def answer_ask(slug, aid, answer):
    with locked(asfile(slug)):
        xs = get_asks(slug)
        for x in xs:
            if x["id"] == aid:
                x["status"], x["answer"], x["answered"] = "answered", str(answer)[:100_000], time.time(); write_json(asfile(slug), xs); return True
    return False
def ask_lines(x):
    return [f"ask #{x['id']} (from the page, on v{x['version']}): {x['prompt']}", f"  answer with: hona answer <slug> {x['id']} \"<text>\"  (or hona_answer)"]

