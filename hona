# ── config, files, locking ──────────────────────────────────────────────────
def config():
    try: return json.loads(CONFIG.read_text())
    except Exception: return {"lan": False}

def save_config(cfg):
    HOME.mkdir(parents=True, exist_ok=True); CONFIG.write_text(json.dumps(cfg)); CONFIG.chmod(0o600)

def lan_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.connect(("10.255.255.255", 1)); ip = s.getsockname()[0]; s.close(); return ip
    except Exception: return None

@contextmanager
def locked(path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(str(path) + ".lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX); yield

def read_json(path, default):
    try: return json.loads(path.read_text())
    except Exception: return default

def write_json(path, data):
    tmp = path.with_suffix(".tmp"); tmp.write_text(json.dumps(data, indent=1)); os.replace(tmp, path)

def slugify(s): return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-") or "untitled"
def meta(slug): return read_json(STORE / slug / "meta.json", None) if ID_RE.match(slug or "") else None
def all_meta():
    out = [m for d in STORE.glob("*") if (m := meta(d.name))]
    return sorted(out, key=lambda m: (not m.get("pinned"), -m["updated"]))

# pages: pin to the top of the index; remove = move to a recoverable trash
TRASH = HOME / "trash"
def pin_page(slug, value):
    m = meta(slug); m["pinned"] = bool(value); write_json(STORE / slug / "meta.json", m)
def remove_page(slug):
    TRASH.mkdir(parents=True, exist_ok=True); dest = TRASH / f"{slug}__{int(time.time())}"; shutil.move(str(STORE / slug), str(dest)); return dest.name
def trash_items():
    out = []
    for d in sorted(TRASH.glob("*__*"), reverse=True) if TRASH.is_dir() else []:
        slug, _, ts = d.name.rpartition("__"); m = read_json(d / "meta.json", {})
        out.append({"name": d.name, "slug": slug, "title": m.get("title", slug), "removed": int(ts) if ts.isdigit() else 0})
    return sorted(out, key=lambda x: -x["removed"])
def restore_page(name):
    src = TRASH / name
    if not src.is_dir(): return None
    slug = name.rpartition("__")[0]; slug = slug if not (STORE / slug).exists() else slug + "-restored"
    shutil.move(str(src), str(STORE / slug))
    m = meta(slug)
    if m and m["slug"] != slug: write_json(STORE / slug / "meta.json", {**m, "slug": slug})
    return slug
def purge_page(name):
    src = TRASH / name
    if src.is_dir() and TRASH.resolve() in src.resolve().parents: shutil.rmtree(src); return True
    return False

# comments: list of {id, author, text, quote, parent, ts, resolved}
def cfile(slug): return STORE / slug / "comments.json"
def raw_comments(slug): return read_json(cfile(slug), [])
def get_comments(slug):
    """Comments the user can see: deleted threads (and their replies) are hidden."""
    cs = raw_comments(slug); gone = {x["id"] for x in cs if x.get("deleted")}
    return [x for x in cs if not x.get("deleted") and x.get("parent") not in gone]
def add_comment(slug, author, text, quote="", parent=None, anchor=None):
    with locked(cfile(slug)):
        cs = raw_comments(slug)
        if parent is not None and not any(x["id"] == parent for x in cs): parent = None
        cm = {"id": max([x["id"] for x in cs], default=0) + 1, "author": author, "text": text[:8000],
              "quote": (quote or "")[:400], "parent": parent, "ts": time.time(), "resolved": False}
        if anchor: cm["anchor"] = anchor
        cm["version"] = cur_version(slug) or None
        cs.append(cm); write_json(cfile(slug), cs)
    return cm
def set_deleted(slug, cid, value):
    with locked(cfile(slug)):
        cs = raw_comments(slug)
        for x in cs:
            if x["id"] == cid and not x["parent"]:
                if value: x["deleted"] = True
                else: x.pop("deleted", None)
        write_json(cfile(slug), cs)
def set_pinned(slug, cid, value):
    with locked(cfile(slug)):
        cs = raw_comments(slug)
        for x in cs:
            if x["id"] == cid and not x["parent"]: x["pinned"] = value
        write_json(cfile(slug), cs)
def set_resolved(slug, cid, value):
    with locked(cfile(slug)):
        cs = raw_comments(slug)
        for x in cs:
            if x["id"] == cid and not x["parent"]: x["resolved"] = value
        write_json(cfile(slug), cs)

# data: STORE/<slug>/data/<collection>.json = {id: doc}
def dfile(slug, coll): return STORE / slug / "data" / f"{coll}.json"
def db_read(slug, coll): return read_json(dfile(slug, coll), {})
def db_write(slug, coll, fn):
    with locked(dfile(slug, coll)):
        d = db_read(slug, coll); out = fn(d); write_json(dfile(slug, coll), d)
    return out

# versions: STORE/<slug>/versions/<n>.html + versions.json [{n, ts, sha, title, size}]
MAX_VERSIONS = 50
def vfile(slug): return STORE / slug / "versions.json"
def get_versions(slug):
    vs = read_json(vfile(slug), None)
    if vs is None and (STORE / slug / "index.html").is_file():  # backfill artifacts from before versioning
        page = (STORE / slug / "index.html").read_text()
        (STORE / slug / "versions").mkdir(exist_ok=True); (STORE / slug / "versions" / "1.html").write_text(page)
        m = meta(slug) or {}
        vs = [{"n": 1, "ts": m.get("updated", time.time()), "sha": hashlib.sha256(page.encode()).hexdigest()[:12], "title": m.get("title", slug), "size": len(page)}]
        write_json(vfile(slug), vs)
    return vs or []
def cur_version(slug): vs = get_versions(slug); return vs[-1]["n"] if vs else 0
def commit_version(slug, page, title):
    """Store page as a new version unless identical to the latest. Returns (n, changed)."""
    d = STORE / slug; d.mkdir(parents=True, exist_ok=True)
    with locked(vfile(slug)):
        vs = get_versions(slug); sha = hashlib.sha256(page.encode()).hexdigest()[:12]
        if vs and vs[-1]["sha"] == sha:
            (d / "index.html").write_text(page); return vs[-1]["n"], False
        n = (vs[-1]["n"] if vs else 0) + 1
        (d / "versions").mkdir(exist_ok=True); (d / "versions" / f"{n}.html").write_text(page)
        vs.append({"n": n, "ts": time.time(), "sha": sha, "title": title, "size": len(page)})
        for old in vs[:-MAX_VERSIONS]: (d / "versions" / f"{old['n']}.html").unlink(missing_ok=True)
        write_json(vfile(slug), vs[-MAX_VERSIONS:]); (d / "index.html").write_text(page)
    return n, True
def version_html(slug, n):
    f = STORE / slug / "versions" / f"{int(n)}.html"; return f.read_text() if f.is_file() else None
def page_text(page):
    t = re.sub(r"(?is)<(script|style|noscript).*?</\1>", "", page)
    t = re.sub(r"(?i)<(br|/p|/div|/li|/tr|/h[1-6]|/section|/article|/pre)[^>]*>", "\n", t)
    t = html.unescape(re.sub(r"<[^>]+>", " ", t))
    return [re.sub(r"\s+", " ", ln).strip() for ln in t.split("\n") if ln.strip()]
def text_diff(slug, a, b):
    ha, hb = version_html(slug, a), version_html(slug, b)
    if ha is None or hb is None: return None
    out = [{"t": ln[0], "s": ln[1:]} for ln in difflib.unified_diff(page_text(ha), page_text(hb), n=0, lineterm="") if ln[:1] in "+-" and ln[:3] not in ("+++", "---")]
    return out

# decisions: STORE/<slug>/decisions.json [{id, decision: approve|changes, note, ts, version}]
def dfile_dec(slug): return STORE / slug / "decisions.json"
def get_decisions(slug): return read_json(dfile_dec(slug), [])
def add_decision(slug, decision, note=""):
    with locked(dfile_dec(slug)):
        ds = get_decisions(slug)
        d = {"id": max([x["id"] for x in ds], default=0) + 1, "decision": decision, "note": (note or "")[:4000], "ts": time.time(), "version": cur_version(slug)}
        ds.append(d); write_json(dfile_dec(slug), ds)
    return d
def current_decision(slug):
    ds = get_decisions(slug); return ds[-1] if ds else None
def decision_label(d):
