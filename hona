def inline_assets(page, d):
    """Inline relative css/js/images next to the page so the export is one file."""
    import base64, mimetypes
    def read(ref):
        if re.match(r"^(https?:|data:|//|/|#)", ref): return None
        f = (d / ref.split("?")[0]).resolve()
        return f if d.resolve() in f.parents and f.is_file() else None
    def css(m):
        f = read(m.group(1)); return f"<style>{f.read_text()}</style>" if f else m.group(0)
    def js(m):
        f = read(m.group(1)); return f"<script>{f.read_text().replace('</script', '<\\/script')}</script>" if f else m.group(0)
    def img(m):
        f = read(m.group(2)); return m.group(1) + f"data:{mimetypes.guess_type(f.name)[0] or 'application/octet-stream'};base64,{base64.b64encode(f.read_bytes()).decode()}" + m.group(3) if f else m.group(0)
    page = re.sub(r"""<link[^>]*rel=["']?stylesheet["']?[^>]*href=["']([^"']+)["'][^>]*>""", css, page)
    page = re.sub(r"""<script[^>]*src=["']([^"']+)["'][^>]*>\s*</script>""", js, page)
    return re.sub(r"""(<img[^>]*src=["'])([^"']+)(["'])""", img, page)

def build_export(slug, with_comments=True):
    import base64
    d = STORE / slug; n = cur_version(slug); page = version_html(slug, n) or (d / "index.html").read_text()
    page = inline_assets(page, d)
    page = re.sub(r"""<link[^>]*href=["']/_/hona\.css["'][^>]*>""", lambda m: "<style>" + (ASSETS / "hona.css").read_text() + "</style>", page)
    icon = '<link rel="icon" href="data:image/svg+xml;base64,' + base64.b64encode((ASSETS / "favicon.svg").read_bytes()).decode() + '">'
    page = re.sub(r"""<link[^>]*href=["']/_/favicon\.svg["'][^>]*>""", "", page)
    page = (re.sub(r"<head[^>]*>", lambda m: m.group(0) + icon, page, 1, flags=re.I) if re.search(r"<head", page, re.I) else icon + page)
    if not with_comments: return page
    dec = current_decision(slug)
    data = {"slug": slug, "title": (meta(slug) or {}).get("title", slug), "version": n, "exported": time.time(), "comments": get_comments(slug),
            "decision": {"current": dec, "version": n, "stale": bool(dec and dec["version"] != n)},
            "choices": {g: {"value": e["value"], "version": e["version"]} for g, e in current_choices(slug).items()},
            "data": {f.stem: read_json(f, {}) for f in (d / "data").glob("*.json")} if (d / "data").is_dir() else {}}
    blob = json.dumps(data).replace("</", "<\\/")
    js = (ASSETS / "hona.js").read_text().replace("</script", "<\\/script")
    tail = f"<script>window.__HONA_STATIC__ = {blob};</script><script>{js}</script>"
    return page.replace("</body>", tail + "</body>", 1) if "</body>" in page else page + tail

